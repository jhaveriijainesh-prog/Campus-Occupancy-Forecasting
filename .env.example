# ==============================================================================
# BDS-06: Environment Configuration Template
# Copy this file to .env and adjust variables as required.
# ==============================================================================

# Application Environment
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# FastAPI Server Settings
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=replace-with-strong-admin-key
API_READ_KEY=replace-with-strong-read-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Streamlit Dashboard Settings
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8501
FASTAPI_INTERNAL_URL=http://api:8000
FASTAPI_PUBLIC_URL=http://127.0.0.1:8000
FASTAPI_API_KEY=replace-with-strong-read-key
DASHBOARD_API_TIMEOUT_SECONDS=0.5

# Storage & Path Mappings
DATA_DIR=data
RAW_DATA_PATH=data/raw
PROCESSED_DATA_PATH=data/processed
MODELS_DIR=models
LOGS_DIR=logs
CONFIGS_DIR=configs

# Optimization Solver Settings
SOLVER_TIMEOUT_SECONDS=30
SOLVER_ENGINE=PULP_CBC_CMD
MIP_GAP_TOLERANCE=0.02

# Experiment & Random Seed Configuration
GLOBAL_RANDOM_SEED=42
ENABLE_TEMPORAL_LEAKAGE_STRICT_MODE=true
